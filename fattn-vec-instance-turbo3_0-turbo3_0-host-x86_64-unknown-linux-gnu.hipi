                                          int node_idx,
                                          int count,
                                          const enum ggml_op * ops,
                                          const int * outputs,
                                          int num_outputs) {
    if (!(count < 32)) ggml_abort("/home/stormrage/llama.cpp/ggml/src/ggml-hip/../ggml-impl.h", 730, "GGML_ASSERT(%s) failed", "count < 32");
    if (node_idx + count > cgraph->n_nodes) {
        return false;
    }

