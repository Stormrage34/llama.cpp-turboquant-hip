      : x(x_), y(y_), z(z_), w(w_) {};
  __attribute__((host)) __attribute__((device))
  constexpr HIP_vector_base(HIP_vector_base&&) = default;
  __attribute__((host)) __attribute__((device))
  ~HIP_vector_base() = default;
