static __attribute__((device)) inline __attribute__((always_inline)) void givens_forward(float &a, float &b, float c, float s) {
    float an = a*c - b*s, bn = a*s + b*c;
    a = an; b = bn;
}

static __attribute__((device)) inline __attribute__((always_inline)) void givens_inverse(float &a, float &b, float c, float s) {
    float an = a*c + b*s, bn = -a*s + b*c;
    a = an; b = bn;
}

static __attribute__((device)) inline __attribute__((always_inline)) void quat_mul(float r[4], const float p[4], const float q[4]) {
    r[0]=p[0]*q[0]-p[1]*q[1]-p[2]*q[2]-p[3]*q[3];
    r[1]=p[0]*q[1]+p[1]*q[0]+p[2]*q[3]-p[3]*q[2];
    r[2]=p[0]*q[2]-p[1]*q[3]+p[2]*q[0]+p[3]*q[1];
    r[3]=p[0]*q[3]+p[1]*q[2]-p[2]*q[1]+p[3]*q[0];
}

static __attribute__((device)) inline __attribute__((always_inline)) void quat_conj(float r[4], const float q[4]) {
    r[0]=q[0]; r[1]=-q[1]; r[2]=-q[2]; r[3]=-q[3];
}


static __attribute__((device)) inline __attribute__((always_inline)) void planar3_get_rotation(int pair_idx, float &c, float &s) {
    c = PI_COS[pair_idx % 64];
    s = PI_SIN[pair_idx % 64];
}


static __attribute__((device)) inline __attribute__((always_inline)) void iso3_get_rotation(int block_idx, float q_L[4], float q_R[4]) {
    int idx = block_idx % 32;

    q_L[0] = PI_QW[idx]; q_L[1] = PI_QX[idx]; q_L[2] = PI_QY[idx]; q_L[3] = PI_QZ[idx];

    q_R[0] = PI_QW_R[idx]; q_R[1] = PI_QX_R[idx]; q_R[2] = PI_QY_R[idx]; q_R[3] = PI_QZ_R[idx];
}
