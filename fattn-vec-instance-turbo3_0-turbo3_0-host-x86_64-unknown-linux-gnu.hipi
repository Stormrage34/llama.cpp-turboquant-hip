static __attribute__((device)) inline __attribute__((always_inline)) void turbo_fwht_128(float * x) {
    for (int h = 1; h < 128; h *= 2) {
        for (int i = 0; i < 128; i += h * 2) {
            for (int j = i; j < i + h; j++) {
                float a = x[j];
                float b = x[j + h];
                x[j] = a + b;
                x[j + h] = a - b;
            }
        }
    }
    const float inv_sqrt_128 = 0.08838834764831845f;
    for (int i = 0; i < 128; i++) {
        x[i] *= inv_sqrt_128;
    }
}




static __attribute__((device)) inline __attribute__((always_inline)) void turbo_fwht_64(float * x) {
    for (int h = 1; h < 64; h *= 2) {
        for (int i = 0; i < 64; i += h * 2) {
            for (int j = i; j < i + h; j++) {
                float a = x[j];
                float b = x[j + h];
                x[j] = a + b;
                x[j + h] = a - b;
            }
        }
    }
    const float inv_sqrt_64 = 0.125f;
    for (int i = 0; i < 64; i++) {
        x[i] *= inv_sqrt_64;
    }
}



static __attribute__((device)) inline __attribute__((always_inline)) void turbo_rotate_forward(float * x) {
    for (int i = 0; i < 128; i++) x[i] *= TURBO_WHT_SIGNS1[i];
    turbo_fwht_128(x);
    for (int i = 0; i < 128; i++) x[i] *= TURBO_WHT_SIGNS2[i];
}



static __attribute__((device)) inline __attribute__((always_inline)) void turbo_rotate_forward_64(float * x) {
    for (int i = 0; i < 64; i++) x[i] *= TURBO_WHT_SIGNS1_64[i];
    turbo_fwht_64(x);
    for (int i = 0; i < 64; i++) x[i] *= TURBO_WHT_SIGNS2_64[i];
}







static __attribute__((device)) float d_innerq_scale[128];
 static __attribute__((device)) float d_innerq_scale_inv[128];
 static __attribute__((device)) float d_innerq_sq_accum[128];
 static __attribute__((device)) int d_innerq_count;
 static __attribute__((device)) int d_innerq_active;
 static __attribute__((device)) int d_innerq_calibrating;

static int innerq_enabled = 0;
static int innerq_target_tokens = 0;
static float innerq_strength = 0.5f;
static bool innerq_initialized = false;


static void turbo_innerq_init(void) {
    if (innerq_initialized) return;
    innerq_initialized = true;

    const char * env = getenv("TURBO_INNERQ");
    if (!env || atoi(env) <= 0) {
        innerq_enabled = 0;
        return;
    }
    innerq_target_tokens = atoi(env);
    innerq_enabled = 1;

    const char * env_str = getenv("TURBO_INNERQ_STRENGTH");
    if (env_str) innerq_strength = atof(env_str);
    if (innerq_strength <= 0.0f || innerq_strength > 1.0f) innerq_strength = 0.5f;


    float zeros[128] = {0};
    int zero = 0, one = 1;
    (void)hipMemcpyToSymbol(d_innerq_sq_accum, zeros, sizeof(zeros));
    (void)hipMemcpyToSymbol(d_innerq_count, &zero, sizeof(int));
    (void)hipMemcpyToSymbol(d_innerq_active, &zero, sizeof(int));
    (void)hipMemcpyToSymbol(d_innerq_calibrating, &one, sizeof(int));

    ggml_log_internal(GGML_LOG_LEVEL_INFO , "%s: InnerQ calibration started (target=%d tokens, strength=%.2f)\n", __func__, innerq_target_tokens, innerq_strength);

}


static void turbo_innerq_finalize(int group_size) {

    float sq_accum[128];
    int count = 0;
    (void)hipMemcpyFromSymbol(sq_accum, d_innerq_sq_accum, group_size * sizeof(float));
    (void)hipMemcpyFromSymbol(&count, d_innerq_count, sizeof(int));

    if (count <= 0) {
        ggml_log_internal(GGML_LOG_LEVEL_WARN , "%s: InnerQ calibration got 0 tokens, disabling\n", __func__);
        innerq_enabled = 0;
        int zero = 0;
        (void)hipMemcpyToSymbol(d_innerq_calibrating, &zero, sizeof(int));
        return;
    }


    float rms[128];
    float mean_rms = 0.0f;
    float max_ratio = 0.0f, min_ratio = 1e30f;
    for (int i = 0; i < group_size; i++) {
        rms[i] = sqrtf(sq_accum[i] / (float)count);
        mean_rms += rms[i];
    }
    mean_rms /= (float)group_size;


    float scale[128];
    float scale_inv[128];
    for (int i = 0; i < group_size; i++) {
        float ratio = (rms[i] > 1e-10f) ? (mean_rms / rms[i]) : 1.0f;
        float s = powf(ratio, innerq_strength);
        if (s < 0.5f) s = 0.5f;
        if (s > 2.0f) s = 2.0f;
        scale[i] = s;
        scale_inv[i] = 1.0f / s;
        if (ratio > max_ratio) max_ratio = ratio;
        if (ratio < min_ratio) min_ratio = ratio;
    }


    if (max_ratio < 1.2f && min_ratio > (1.0f / 1.2f)) {
        ggml_log_internal(GGML_LOG_LEVEL_INFO , "%s: InnerQ auto-disabled (channels already balanced, max_ratio=%.3f)\n", __func__, max_ratio);

        innerq_enabled = 0;
        int zero = 0;
        (void)hipMemcpyToSymbol(d_innerq_calibrating, &zero, sizeof(int));
        return;
    }


    int zero = 0, one = 1;
    do { auto err_ = (hipMemcpyToSymbol(d_innerq_calibrating, &zero, sizeof(int))); if (err_ != (hipSuccess)) { ggml_cuda_error("hipMemcpyToSymbol(d_innerq_calibrating, &zero, sizeof(int))", __func__, "/home/stormrage/llama.cpp/ggml/src/ggml-cuda/template-instances/../turbo-quant.cuh", 250, hipGetErrorString(err_)); } } while (0);
    do { auto err_ = (hipMemcpyToSymbol(d_innerq_scale, scale, group_size * sizeof(float))); if (err_ != (hipSuccess)) { ggml_cuda_error("hipMemcpyToSymbol(d_innerq_scale, scale, group_size * sizeof(float))", __func__, "/home/stormrage/llama.cpp/ggml/src/ggml-cuda/template-instances/../turbo-quant.cuh", 251, hipGetErrorString(err_)); } } while (0);
    do { auto err_ = (hipMemcpyToSymbol(d_innerq_scale_inv, scale_inv, group_size * sizeof(float))); if (err_ != (hipSuccess)) { ggml_cuda_error("hipMemcpyToSymbol(d_innerq_scale_inv, scale_inv, group_size * sizeof(float))", __func__, "/home/stormrage/llama.cpp/ggml/src/ggml-cuda/template-instances/../turbo-quant.cuh", 252, hipGetErrorString(err_)); } } while (0);
    do { auto err_ = (hipDeviceSynchronize()); if (err_ != (hipSuccess)) { ggml_cuda_error("hipDeviceSynchronize()", __func__, "/home/stormrage/llama.cpp/ggml/src/ggml-cuda/template-instances/../turbo-quant.cuh", 253, hipGetErrorString(err_)); } } while (0);
    do { auto err_ = (hipMemcpyToSymbol(d_innerq_active, &one, sizeof(int))); if (err_ != (hipSuccess)) { ggml_cuda_error("hipMemcpyToSymbol(d_innerq_active, &one, sizeof(int))", __func__, "/home/stormrage/llama.cpp/ggml/src/ggml-cuda/template-instances/../turbo-quant.cuh", 254, hipGetErrorString(err_)); } } while (0);

    innerq_enabled = 2;


    turbo_innerq_publish(scale_inv, group_size);

    ggml_log_internal(GGML_LOG_LEVEL_INFO , "%s: InnerQ finalized (%d tokens, max_ratio=%.3f, min_ratio=%.3f)\n", __func__, count, max_ratio, min_ratio);

}


static void turbo_innerq_check_finalize(int group_size, int64_t ne00) {
    if (!innerq_initialized) {
        turbo_innerq_init();
    }
    if (innerq_enabled == 0) return;







    const bool multi_group_per_head = (group_size < 128);
    if (multi_group_per_head) {
        if (innerq_enabled == 1) {
            ggml_log_internal(GGML_LOG_LEVEL_WARN , "%s: InnerQ disabled (ne00=%lld != group_size=%d, multi-group heads)\n", __func__, (long long)ne00, group_size);

            innerq_enabled = 0;
            int zero = 0;
            (void)hipMemcpyToSymbol(d_innerq_calibrating, &zero, sizeof(int));
        }
        return;
    }


    if (innerq_enabled == 1) {
        int count = 0;
        (void)hipMemcpyFromSymbol(&count, d_innerq_count, sizeof(int));
        if (count >= innerq_target_tokens) {
            turbo_innerq_finalize(group_size);
        }
    }
}


static bool turbo_innerq_is_active(void) {
    return innerq_enabled == 2;
}



static __attribute__((constant)) float TURBO_CENTROIDS_4BIT[16] = {
    -0.173926f, -0.117195f, -0.089527f, -0.068756f,
    -0.051262f, -0.035597f, -0.020989f, -0.006938f,
     0.006938f, 0.020989f, 0.035597f, 0.051262f,
     0.068756f, 0.089527f, 0.117195f, 0.173926f
};



static __attribute__((constant)) float TURBO_MID_4BIT[15] = {
    -0.145561f, -0.103361f, -0.079142f, -0.060009f,
    -0.043430f, -0.028293f, -0.013964f, 0.000000f,
     0.013964f, 0.028293f, 0.043430f, 0.060009f,
     0.079142f, 0.103361f, 0.145561f
};



static __attribute__((device)) inline __attribute__((always_inline)) uint8_t turbo_nearest_centroid_4bit(float val) {

    int left_half = (val < TURBO_MID_4BIT[7]) ? 1 : 0;


    int cmp_L2L = (val < TURBO_MID_4BIT[3]) ? 1 : 0;
    int cmp_L2R = (val < TURBO_MID_4BIT[11]) ? 1 : 0;
    int cmp_L2 = left_half ? cmp_L2L : cmp_L2R;


    int cmp_L3LL = (val < TURBO_MID_4BIT[1]) ? 1 : 0;
    int cmp_L3LR = (val < TURBO_MID_4BIT[5]) ? 1 : 0;
    int cmp_L3RL = (val < TURBO_MID_4BIT[9]) ? 1 : 0;
    int cmp_L3RR = (val < TURBO_MID_4BIT[13]) ? 1 : 0;

    int cmp_L3 = left_half ? (cmp_L2 ? cmp_L3LL : cmp_L3LR) : (cmp_L2 ? cmp_L3RL : cmp_L3RR);


    int cmp_L4LLL = (val < TURBO_MID_4BIT[0]) ? 1 : 0;
    int cmp_L4LLR = (val < TURBO_MID_4BIT[2]) ? 1 : 0;
    int cmp_L4LRL = (val < TURBO_MID_4BIT[4]) ? 1 : 0;
    int cmp_L4LRR = (val < TURBO_MID_4BIT[6]) ? 1 : 0;
    int cmp_L4RLL = (val < TURBO_MID_4BIT[8]) ? 1 : 0;
    int cmp_L4RLR = (val < TURBO_MID_4BIT[10]) ? 1 : 0;
    int cmp_L4RRL = (val < TURBO_MID_4BIT[12]) ? 1 : 0;
    int cmp_L4RRR = (val < TURBO_MID_4BIT[14]) ? 1 : 0;

    int cmp_L4 = left_half ? (cmp_L2 ? (cmp_L3 ? cmp_L4LLL : cmp_L4LLR) : (cmp_L3 ? cmp_L4LRL : cmp_L4LRR))
                           : (cmp_L2 ? (cmp_L3 ? cmp_L4RLL : cmp_L4RLR) : (cmp_L3 ? cmp_L4RRL : cmp_L4RRR));

    int bits = (left_half << 3) | (cmp_L2 << 2) | (cmp_L3 << 1) | cmp_L4;
    return (uint8_t)(bits ^ 15);
}



static __attribute__((device)) void quantize_f32_turbo4_0_block(const float * __restrict__ src,
                                                    block_turbo4_0 * __restrict__ dst) {
    for (int j = 0; j < 128 / 2; j++) dst->qs[j] = 0;

    for (int j = 0; j < 128; j++) {
        uint8_t idx = turbo_nearest_centroid_4bit(src[j]);
        dst->qs[j / 2] |= (idx & 0xF) << ((j % 2) * 4);
    }
}



static __attribute__((device)) inline __attribute__((always_inline)) float turbo4_dequant_element(
        const block_turbo4_0 * __restrict__ x, int j, float norm) {
    uint8_t idx = (x->qs[j / 2] >> ((j % 2) * 4)) & 0xF;
    return TURBO_CENTROIDS_4BIT[idx] * norm;
}



static __attribute__((device)) inline __attribute__((always_inline)) uint8_t turbo_nearest_centroid_3bit(float val) {

    int left = (val < TURBO_MID_3BIT[3]) ? 1 : 0;


    int cmp_left = (val < TURBO_MID_3BIT[1]) ? 1 : 0;
    int cmp_right = (val < TURBO_MID_3BIT[5]) ? 1 : 0;
    int cmp_l2 = left ? cmp_left : cmp_right;


    int cmp_ll = (val < TURBO_MID_3BIT[0]) ? 1 : 0;
    int cmp_lr = (val < TURBO_MID_3BIT[2]) ? 1 : 0;
    int cmp_rl = (val < TURBO_MID_3BIT[4]) ? 1 : 0;
    int cmp_rr = (val < TURBO_MID_3BIT[6]) ? 1 : 0;

    int cmp_l3 = left ? (cmp_l2 ? cmp_ll : cmp_lr) : (cmp_l2 ? cmp_rl : cmp_rr);

    int bits = (left << 2) | (cmp_l2 << 1) | cmp_l3;
    return (uint8_t)(bits ^ 7);
}




static __attribute__((device)) void quantize_f32_turbo3_0_block(const float * __restrict__ src,
                                                    block_turbo3_0 * __restrict__ dst) {
    for (int j = 0; j < 128 / 4; j++) dst->qs[j] = 0;
    for (int j = 0; j < 128 / 8; j++) dst->signs[j] = 0;

    for (int j = 0; j < 128; j++) {
        uint8_t idx = turbo_nearest_centroid_3bit(src[j]);
        dst->qs[j / 4] |= (idx & 0x3) << ((j % 4) * 2);
        if (idx & 0x4) {
            dst->signs[j / 8] |= (1 << (j % 8));
        }
    }
}



static __attribute__((device)) inline __attribute__((always_inline)) float turbo3_dequant_element(
        const block_turbo3_0 * __restrict__ x, int j, float norm) {
    uint8_t low2 = (x->qs[j / 4] >> ((j % 4) * 2)) & 0x3;
    uint8_t hi1 = (x->signs[j / 8] >> (j % 8)) & 0x1;
    uint8_t idx = low2 | (hi1 << 2);
    return TURBO_CENTROIDS_3BIT[idx] * norm;
}



static __attribute__((device)) inline __attribute__((always_inline)) uint8_t turbo_nearest_centroid_2bit(float val) {

    int left = (val < TURBO_MID_2BIT[1]) ? 1 : 0;


    int cmp_left = (val < TURBO_MID_2BIT[0]) ? 1 : 0;
    int cmp_right = (val < TURBO_MID_2BIT[2]) ? 1 : 0;

    int cmp_l2 = left ? cmp_left : cmp_right;







    int bits = (left << 1) | cmp_l2;
    return (uint8_t)(bits ^ 3);
}



static __attribute__((device)) void quantize_f32_turbo2_0_block(const float * __restrict__ src,
                                                    block_turbo2_0 * __restrict__ dst) {
    for (int j = 0; j < 128 / 4; j++) dst->qs[j] = 0;

    for (int j = 0; j < 128; j++) {
        uint8_t idx = turbo_nearest_centroid_2bit(src[j]);
        dst->qs[j / 4] |= (idx & 0x3) << ((j % 4) * 2);
    }
}



static __attribute__((device)) inline __attribute__((always_inline)) float turbo2_dequant_element(
        const block_turbo2_0 * __restrict__ x, int j, float norm) {
    uint8_t idx = (x->qs[j / 4] >> ((j % 4) * 2)) & 0x3;
    return TURBO_CENTROIDS_2BIT[idx] * norm;
}





static __attribute__((device)) inline __attribute__((always_inline)) void dequantize_turbo3_0(const void * vx, const int64_t ib, const int iqs, float2 & v) {
    const block_turbo3_0 * x = (const block_turbo3_0 *) vx;
    const float norm = __half2float(x[ib].norm);
    uint8_t low0 = (x[ib].qs[iqs / 4] >> ((iqs % 4) * 2)) & 0x3;
    uint8_t hi0 = (x[ib].signs[iqs / 8] >> (iqs % 8)) & 0x1;
    uint8_t idx0 = low0 | (hi0 << 2);
    int iqs1 = iqs + 1;
    uint8_t low1 = (x[ib].qs[iqs1 / 4] >> ((iqs1 % 4) * 2)) & 0x3;
    uint8_t hi1 = (x[ib].signs[iqs1 / 8] >> (iqs1 % 8)) & 0x1;
    uint8_t idx1 = low1 | (hi1 << 2);
    v.x = TURBO_CENTROIDS_3BIT[idx0] * norm;
    v.y = TURBO_CENTROIDS_3BIT[idx1] * norm;
}

static __attribute__((device)) inline __attribute__((always_inline)) void dequantize_turbo4_0(const void * vx, const int64_t ib, const int iqs, float2 & v) {
    const block_turbo4_0 * x = (const block_turbo4_0 *) vx;
    const float norm = __half2float(x[ib].norm);
    uint8_t idx0 = (x[ib].qs[iqs / 2] >> ((iqs % 2) * 4)) & 0xF;
    int iqs1 = iqs + 1;
    uint8_t idx1 = (x[ib].qs[iqs1 / 2] >> ((iqs1 % 2) * 4)) & 0xF;
    v.x = TURBO_CENTROIDS_4BIT[idx0] * norm;
    v.y = TURBO_CENTROIDS_4BIT[idx1] * norm;
}

static __attribute__((device)) inline __attribute__((always_inline)) void dequantize_turbo2_0(const void * vx, const int64_t ib, const int iqs, float2 & v) {
    const block_turbo2_0 * x = (const block_turbo2_0 *) vx;
    uint8_t idx0 = (x[ib].qs[iqs / 4] >> ((iqs % 4) * 2)) & 0x3;
    int iqs1 = iqs + 1;
    uint8_t idx1 = (x[ib].qs[iqs1 / 4] >> ((iqs1 % 4) * 2)) & 0x3;
    v.x = TURBO_CENTROIDS_2BIT[idx0];
    v.y = TURBO_CENTROIDS_2BIT[idx1];
}
