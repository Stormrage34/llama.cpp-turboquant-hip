__attribute__((device)) inline static void __work_group_barrier(__cl_mem_fence_flags flags) {
  if (flags == (0x02 | 0x01)) {
    __builtin_amdgcn_fence(3, "workgroup");
    __builtin_amdgcn_s_barrier();
    __builtin_amdgcn_fence(2, "workgroup");
  } else if (flags & (0x02)) {
    __builtin_amdgcn_fence(3, "workgroup", "global");
    __builtin_amdgcn_s_barrier();
    __builtin_amdgcn_fence(2, "workgroup", "global");
  } else if (flags & (0x01)) {
    __builtin_amdgcn_fence(3, "workgroup", "local");
    __builtin_amdgcn_s_barrier();
    __builtin_amdgcn_fence(2, "workgroup", "local");
  } else {
    __builtin_amdgcn_s_barrier();
  }
}

