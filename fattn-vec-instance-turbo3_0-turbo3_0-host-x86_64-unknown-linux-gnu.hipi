template <int n>
struct ggml_cuda_unroll {
    template <typename Func, typename... Args>
    __attribute__((device)) void operator()(const Func & f, Args... args) const {
        f(n - 1, args...);
        ggml_cuda_unroll<n - 1>{}(f, args...);
    }
};

template <>
struct ggml_cuda_unroll<1> {
    template <typename Func, typename... Args>
    __attribute__((device)) void operator()(const Func & f, Args... args) const {
        f(0, args...);
    }
};

