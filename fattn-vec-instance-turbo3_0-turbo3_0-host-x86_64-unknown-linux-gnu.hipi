            int sumi_m1 = 0;
#pragma unroll
            for (int i = i0 + (32 / (4 * 1))/2; i < i0 + (32 / (4 * 1)); ++i) {
                sumi_m1 = ggml_cuda_dp4a(0x01010101, u[i], sumi_m1);
