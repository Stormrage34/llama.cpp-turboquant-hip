    return dm2f.x*sumf_d - dm2f.y*sumf_m;
}


template <int ns8>
static __attribute__((device)) inline __attribute__((always_inline)) float vec_dot_q2_K_q8_1_impl_mmq(
    const int * __restrict__ v, const int * __restrict__ u, const half2 * dm2, const float & d8, const half2 * s8) {

    float sumf = 0.0f;
    float sumf_d8 = 0.0f;

#pragma unroll
    for (int i0 = 0; i0 < 4*4; i0 += (32 / (4 * 1))) {
        const float2 dm2f0 = __half22float2(dm2[i0/((32 / (4 * 1))/2) + 0]);
