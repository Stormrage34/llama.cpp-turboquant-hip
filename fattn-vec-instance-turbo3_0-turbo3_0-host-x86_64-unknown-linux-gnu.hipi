static bool fp16_available(const int cc) {
    return ggml_cuda_highest_compiled_arch(cc) >= 600 ||
        ((cc >= 0x0100000 && cc < 0x1000000) && cc >= (0x0100000 + 0x310));
}

static bool fast_fp16_available(const int cc) {
    return (cc >= 0x1000000) ||
        ((cc < 0x0100000) && fp16_available(cc) && ggml_cuda_highest_compiled_arch(cc) != 610) ||
        ((cc >= 0x0100000 && cc < 0x1000000) && fp16_available(cc));
}


static bool fast_fp16_hardware_available(const int cc) {
    return ((cc < 0x0100000) && cc >= 600 && cc != 610) || (cc >= 0x1000000) ||
        ((cc >= 0x0100000 && cc < 0x1000000) && cc >= (0x0100000 + 0x220));
}


static bool fp16_mma_hardware_available(const int cc) {
    return ((cc < 0x0100000) && cc >= 700) ||
        (cc >= (0x1000000 + 0x908) && cc < (0x1000000 + 0x1010)) || ((cc >= (0x1000000 + 0x1100) && cc < (0x1000000 + 0x1150)) || (cc >= (0x1000000 + 0x1150) && cc < (0x1000000 + 0x1200))) || (cc >= (0x1000000 + 0x1200)) ||
        ((cc >= 0x0100000 && cc < 0x1000000) && cc >= (0x0100000 + 0x220));
}

static bool bf16_mma_hardware_available(const int cc) {
    return ((cc < 0x0100000) && cc >= 800) ||
        (cc >= (0x1000000 + 0x908) && cc < (0x1000000 + 0x1010)) || cc >= (0x1000000 + 0x1100) ||
        ((cc >= 0x0100000 && cc < 0x1000000) && cc >= (0x0100000 + 0x310));
}

static bool fp32_mma_hardware_available(const int cc) {
    return (cc >= (0x1000000 + 0x908) && cc < (0x1000000 + 0x1010));
}

static bool amd_mfma_available(const int cc) {

    return (cc >= (0x1000000 + 0x908) && cc < (0x1000000 + 0x1010));



}

static bool amd_wmma_available(const int cc) {
    return ((cc >= (0x1000000 + 0x1200)) || ((cc >= (0x1000000 + 0x1100) && cc < (0x1000000 + 0x1150)) || (cc >= (0x1000000 + 0x1150) && cc < (0x1000000 + 0x1200))));
}

static bool volta_mma_available(const int cc) {
    return (cc < 0x0100000) && ggml_cuda_highest_compiled_arch(cc) == 700;
}

static bool turing_mma_available(const int cc) {
    return (cc < 0x0100000) && ggml_cuda_highest_compiled_arch(cc) >= 750;
}

static bool ampere_mma_available(const int cc) {
    return (cc < 0x0100000) && ggml_cuda_highest_compiled_arch(cc) >= 800;
}

static bool cp_async_available(const int cc) {
    return (cc < 0x0100000) && ggml_cuda_highest_compiled_arch(cc) >= 800;
}

static bool blackwell_mma_available(const int cc) {
    return (cc < 0x0100000) && ggml_cuda_highest_compiled_arch(cc) >= 1200 &&
           ggml_cuda_highest_compiled_arch(cc) < 1300;
}

