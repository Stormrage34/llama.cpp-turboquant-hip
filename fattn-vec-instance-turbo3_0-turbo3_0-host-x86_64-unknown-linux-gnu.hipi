struct ggml_backend_cuda_context {
    int device;
    std::string name;
    hipEvent_t copy_event = nullptr;

    hipStream_t streams[16][8] = { { nullptr } };
    hipblasHandle_t cublas_handles[16] = {nullptr};

    int curr_stream_no = 0;




    std::unordered_map<const void *, std::unique_ptr<ggml_cuda_graph>> cuda_graphs;

    int64_t last_graph_eviction_sweep = 0;

    ggml_cuda_graph * cuda_graph(const void * first_node_ptr) {
        const int64_t time_now = ggml_time_us();


        if (time_now - last_graph_eviction_sweep >= 5'000'000) {
            last_graph_eviction_sweep = time_now;
            for (auto it = cuda_graphs.begin(); it != cuda_graphs.end(); ) {
                if (time_now - it->second->last_used_time >= 10'000'000) {
                    it = cuda_graphs.erase(it);
                } else {
                    ++it;
                }
            }
        }

        auto it = cuda_graphs.find(first_node_ptr);
        if (it == cuda_graphs.end()) {
            it = cuda_graphs.emplace(first_node_ptr, std::make_unique<ggml_cuda_graph>()).first;
        }
        it->second->last_used_time = time_now;
        return it->second.get();
    }



    bool any_cuda_graph_enabled() const {
        for (const auto & [key, graph] : cuda_graphs) {
            if (graph && graph->is_enabled()) {
                return true;
            }
        }
        return false;
    }


    bool any_cuda_graph_has_instance() const {
        for (const auto & [key, graph] : cuda_graphs) {
            if (graph && graph->instance != nullptr) {
                return true;
            }
        }
        return false;
    }


    explicit ggml_backend_cuda_context(int device) :
        device(device),
        name("ROCm" + std::to_string(device)) {
    }

    ggml_cuda_stream_context concurrent_stream_context;

    ~ggml_backend_cuda_context();

    hipStream_t stream(int device, int stream) {
        if (streams[device][stream] == nullptr) {
            ggml_cuda_set_device(device);
            do { auto err_ = (hipStreamCreateWithFlags(&streams[device][stream], 0x01)); if (err_ != (hipSuccess)) { ggml_cuda_error("hipStreamCreateWithFlags(&streams[device][stream], 0x01)", __func__, "/home/stormrage/llama.cpp/ggml/src/ggml-cuda/template-instances/../common.cuh", 1469, hipGetErrorString(err_)); } } while (0);
        }
        return streams[device][stream];
    }

    hipStream_t stream() { return stream(device, curr_stream_no); }

    ggml_cuda_stream_context & stream_context() { return concurrent_stream_context; }

    hipblasHandle_t cublas_handle(int device) {
        if (cublas_handles[device] == nullptr) {
            ggml_cuda_set_device(device);
            do { auto err_ = (hipblasCreate(&cublas_handles[device])); if (err_ != (HIPBLAS_STATUS_SUCCESS)) { ggml_cuda_error("hipblasCreate(&cublas_handles[device])", __func__, "/home/stormrage/llama.cpp/ggml/src/ggml-cuda/template-instances/../common.cuh", 1481, cublas_get_error_str(err_)); } } while (0);
            do { auto err_ = (HIPBLAS_STATUS_SUCCESS); if (err_ != (HIPBLAS_STATUS_SUCCESS)) { ggml_cuda_error("HIPBLAS_STATUS_SUCCESS", __func__, "/home/stormrage/llama.cpp/ggml/src/ggml-cuda/template-instances/../common.cuh", 1482, cublas_get_error_str(err_)); } } while (0);
        }
        return cublas_handles[device];
    }

    hipblasHandle_t cublas_handle() {
        return cublas_handle(device);
    }


    std::unique_ptr<ggml_cuda_pool> pools[16][8];

    static std::unique_ptr<ggml_cuda_pool> new_pool_for_device(int device, int stream_no);

    ggml_cuda_pool & pool(int device) {
        if (pools[device][curr_stream_no] == nullptr) {
            pools[device][curr_stream_no] = new_pool_for_device(device, curr_stream_no);
        }
        return *pools[device][curr_stream_no];
    }

    ggml_cuda_pool & pool() {
        return pool(device);
    }
};

