  unsigned long long y1 = y >> 32;
  unsigned long long z0 = x0 * y0;
  unsigned long long t = x1 * y0 + (z0 >> 32);
  unsigned long long z1 = t & 0xffffffffUL;
  unsigned long long z2 = t >> 32;
  z1 = x0 * y1 + z1;
  return x1 * y1 + z2 + (z1 >> 32);
}

