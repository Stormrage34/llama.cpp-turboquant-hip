typedef float2 hipFloatComplex;

__attribute__((host)) __attribute__((device)) static inline float hipCrealf(hipFloatComplex z) { return z.x; }

__attribute__((host)) __attribute__((device)) static inline float hipCimagf(hipFloatComplex z) { return z.y; }

__attribute__((host)) __attribute__((device)) static inline hipFloatComplex make_hipFloatComplex(float a, float b) {
  hipFloatComplex z;
  z.x = a;
  z.y = b;
  return z;
}

__attribute__((host)) __attribute__((device)) static inline hipFloatComplex hipConjf(hipFloatComplex z) {
  hipFloatComplex ret;
  ret.x = z.x;
  ret.y = -z.y;
  return ret;
}

__attribute__((host)) __attribute__((device)) static inline float hipCsqabsf(hipFloatComplex z) { return z.x * z.x + z.y * z.y; }

__attribute__((host)) __attribute__((device)) static inline hipFloatComplex hipCaddf(hipFloatComplex p, hipFloatComplex q) {
  return make_hipFloatComplex(p.x + q.x, p.y + q.y);
}

__attribute__((host)) __attribute__((device)) static inline hipFloatComplex hipCsubf(hipFloatComplex p, hipFloatComplex q) {
  return make_hipFloatComplex(p.x - q.x, p.y - q.y);
}

__attribute__((host)) __attribute__((device)) static inline hipFloatComplex hipCmulf(hipFloatComplex p, hipFloatComplex q) {
  return make_hipFloatComplex(p.x * q.x - p.y * q.y, p.y * q.x + p.x * q.y);
}

__attribute__((host)) __attribute__((device)) static inline hipFloatComplex hipCdivf(hipFloatComplex p, hipFloatComplex q) {
  float sqabs = hipCsqabsf(q);
  hipFloatComplex ret;
  ret.x = (p.x * q.x + p.y * q.y) / sqabs;
  ret.y = (p.y * q.x - p.x * q.y) / sqabs;
  return ret;
}

__attribute__((host)) __attribute__((device)) static inline float hipCabsf(hipFloatComplex z) { return sqrtf(hipCsqabsf(z)); }


typedef double2 hipDoubleComplex;

__attribute__((host)) __attribute__((device)) static inline double hipCreal(hipDoubleComplex z) { return z.x; }

__attribute__((host)) __attribute__((device)) static inline double hipCimag(hipDoubleComplex z) { return z.y; }

__attribute__((host)) __attribute__((device)) static inline hipDoubleComplex make_hipDoubleComplex(double a, double b) {
  hipDoubleComplex z;
  z.x = a;
  z.y = b;
  return z;
}

__attribute__((host)) __attribute__((device)) static inline hipDoubleComplex hipConj(hipDoubleComplex z) {
  hipDoubleComplex ret;
  ret.x = z.x;
  ret.y = -z.y;
  return ret;
}

__attribute__((host)) __attribute__((device)) static inline double hipCsqabs(hipDoubleComplex z) { return z.x * z.x + z.y * z.y; }

__attribute__((host)) __attribute__((device)) static inline hipDoubleComplex hipCadd(hipDoubleComplex p, hipDoubleComplex q) {
  return make_hipDoubleComplex(p.x + q.x, p.y + q.y);
}

__attribute__((host)) __attribute__((device)) static inline hipDoubleComplex hipCsub(hipDoubleComplex p, hipDoubleComplex q) {
  return make_hipDoubleComplex(p.x - q.x, p.y - q.y);
}

__attribute__((host)) __attribute__((device)) static inline hipDoubleComplex hipCmul(hipDoubleComplex p, hipDoubleComplex q) {
  return make_hipDoubleComplex(p.x * q.x - p.y * q.y, p.y * q.x + p.x * q.y);
}

__attribute__((host)) __attribute__((device)) static inline hipDoubleComplex hipCdiv(hipDoubleComplex p, hipDoubleComplex q) {
  double sqabs = hipCsqabs(q);
  hipDoubleComplex ret;
  ret.x = (p.x * q.x + p.y * q.y) / sqabs;
  ret.y = (p.y * q.x - p.x * q.y) / sqabs;
  return ret;
}

__attribute__((host)) __attribute__((device)) static inline double hipCabs(hipDoubleComplex z) { return sqrt(hipCsqabs(z)); }

typedef hipFloatComplex hipComplex;

__attribute__((host)) __attribute__((device)) static inline hipComplex make_hipComplex(float x, float y) {
  return make_hipFloatComplex(x, y);
}

__attribute__((host)) __attribute__((device)) static inline hipFloatComplex hipComplexDoubleToFloat(hipDoubleComplex z) {
  return make_hipFloatComplex((float)z.x, (float)z.y);
}

__attribute__((host)) __attribute__((device)) static inline hipDoubleComplex hipComplexFloatToDouble(hipFloatComplex z) {
  return make_hipDoubleComplex((double)z.x, (double)z.y);
}

__attribute__((host)) __attribute__((device)) static inline hipComplex hipCfmaf(hipComplex p, hipComplex q, hipComplex r) {
  float real = (p.x * q.x) + r.x;
  float imag = (q.x * p.y) + r.y;

  real = -(p.y * q.y) + real;
  imag = (p.x * q.y) + imag;

  return make_hipComplex(real, imag);
}

__attribute__((host)) __attribute__((device)) static inline hipDoubleComplex hipCfma(hipDoubleComplex p, hipDoubleComplex q,
                                                       hipDoubleComplex r) {
  double real = (p.x * q.x) + r.x;
  double imag = (q.x * p.y) + r.y;

  real = -(p.y * q.y) + real;
  imag = (p.x * q.y) + imag;

  return make_hipDoubleComplex(real, imag);
}
