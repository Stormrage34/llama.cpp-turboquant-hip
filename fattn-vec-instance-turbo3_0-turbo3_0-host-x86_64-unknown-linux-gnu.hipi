                                         unsigned int val) {
  __hip_atomic_compare_exchange_strong(address, &compare, val, 0, 0,
                                       4);
  return compare;
}

__attribute__((device)) inline unsigned int atomicCAS_system(unsigned int* address, unsigned int compare,
