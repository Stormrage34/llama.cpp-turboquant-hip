__attribute__((device)) inline unsigned assemble_smid(unsigned xcc, unsigned se, unsigned sa,
                                         unsigned wgp, unsigned cu,
                                         unsigned se_bits, unsigned sa_bits,
                                         unsigned wgp_bits, unsigned cu_bits)
{
